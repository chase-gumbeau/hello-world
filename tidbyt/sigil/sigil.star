"""
Applet: Ultrahand Sigil
Summary: Glowing Ultrahand sigil, centered
Description: Shows a 32x32 Ultrahand sigil centered on the 64x32 display.
Author: Chase Chenevert
"""

load("encoding/base64.star", "base64")
load("render.star", "render")

# 32x32 PNG, downscaled from sigil-source.png with: sips -z 32 32 sigil-source.png --out sigil-32.png
SIGIL = base64.decode("""

""")

def main():
    return render.Root(
        child = render.Box(
            color = "#000",
            child = render.Image(src = SIGIL, width = 32, height = 32),
        ),
    )
